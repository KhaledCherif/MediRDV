<?xml version="1.0" encoding="UTF-8"?>
<!-- =====================================================================
     Schéma XSD contract-first - Service assurance-legacy (MediRDV)
  
     ===================================================================== -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="http://medirdv.com/assurance-legacy"
           targetNamespace="http://medirdv.com/assurance-legacy"
           elementFormDefault="qualified">


  <xs:element name="verifierDroitsRequest">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="numeroAssure" type="xs:string"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="verifierDroitsResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="couverture" type="xs:boolean"/>
        <xs:element name="taux" type="xs:decimal"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>


  <xs:element name="declarerConsultationRequest">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="numeroAssure" type="xs:string"/>
        <xs:element name="date" type="xs:dateTime"/>
        <xs:element name="praticien" type="xs:string"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="declarerConsultationResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="accuse" type="xs:string"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
